# =====================================================================
# Docsmith environment — single source of truth
# Copy to .env and fill in. .env is chmod 600 and never committed.
# =====================================================================

# ---- Application ----
APP_NAME=Docsmith
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ---- Database (panel-managed on the VPS) ----
# In production the control panel writes POSTGRES_HOST/PORT/DB/USER/PASSWORD
# and DATABASE_URL itself; leave them as-is locally for docker-compose.dev.yml.
POSTGRES_USER=docsmith
POSTGRES_PASSWORD=docsmith
POSTGRES_DB=docsmith
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Auth ----
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Set true in production (HTTPS); false locally.
COOKIE_SECURE=false
# Comma-separated origins allowed to call the API from a browser (dev only;
# production is same-origin). E.g. http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated emails allowed to register/login. Empty = open.
AUTHORIZED_USERS=

# ---- Encryption (Fernet) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt Google refresh tokens. Never stored in the DB.
ENCRYPTION_KEY=

# ---- Google OAuth ----
# OAuth client (Web application) from console.cloud.google.com, project "Docsmith".
# Enable Google Docs API + Google Drive API, add test users while in Testing.
# Spreadsheets also require the Google Sheets API enabled on the same project.
# Redirect URIs:
#   production: https://docsmith.andrewallkin.cloud/api/google/callback
#   dev:        http://localhost:8000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback
